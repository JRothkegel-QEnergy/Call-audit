# HTTPS automático (Let's Encrypt) para el dominio de DOMAIN. Todo va al front; el front reenvía /api/* a la API.
{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
	}
	# Visor SQL de solo lectura (docs/db-readonly-access.md). La clave se pide aquí, antes de llegar a pgweb.
	handle /db* {
		basic_auth {
			{$PGWEB_USER} {$PGWEB_AUTH_HASH}
		}
		reverse_proxy pgweb:8081
	}
	handle {
		reverse_proxy front:3000
	}
}
