# Copiar a .env y completar. Nunca commitear .env.
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
# Vacío = SQLite local (call_audit.db). En AWS: postgresql+psycopg://usuario:clave@host:5432/auditoria
DATABASE_URL=
S3_BUCKET=
S3_PREFIX=audios/
AWS_REGION=sa-east-1

# API (src/call_audit/api)
# Secreto largo y aleatorio; obligatorio fuera de desarrollo.
SESSION_SECRET=
# true detrás de HTTPS
COOKIE_SECURE=false
# lax si front y API comparten dominio; none (con COOKIE_SECURE=true) si no
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
GOLDEN_SET_PATH=

# Prompt bench (scripts/prompt_bench/run.py)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
JEV_API_KEY=
